# FIX Server Configuration
# Copy this file to config.toml and fill in your credentials

[order_management]
gateway_url = "host:port"
sender_comp_id = "YOUR_SENDER_COMP_ID"
target_comp_id = "YOUR_TARGET_COMP_ID"

[market_data_btc]
gateway_url = "host:port"
sender_comp_id = "YOUR_SENDER_COMP_ID"
target_comp_id = "YOUR_TARGET_COMP_ID"

[market_data_others]
base_url = "host"
sender_comp_id = "YOUR_SENDER_COMP_ID"
target_comp_id = "YOUR_TARGET_COMP_ID"
port_34405 = 34405
port_34406 = 34406
port_34407 = 34407

[api]
api_key = "YOUR_API_KEY"
api_secret = "YOUR_API_SECRET"

[connection]
heartbeat_interval = 5
max_reconnect_attempts = 10
reconnect_backoff_ms = 1000
